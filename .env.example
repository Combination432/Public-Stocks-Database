# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/financial_db
# For Replit, use: postgresql://user:password@0.0.0.0:5432/financial_db

# Redis Configuration (for Celery and caching)
REDIS_URL=redis://localhost:6379/0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
API_KEY_HEADER=X-API-Key

# Default API Keys (comma-separated, generate secure ones for production)
VALID_API_KEYS=demo-key-12345,test-key-67890

# SEC EDGAR Configuration
SEC_USER_AGENT=YourCompany contact@yourcompany.com
SEC_RATE_LIMIT_DELAY=0.1  # seconds between requests (SEC requires 10 requests/second max)

# ETL Configuration
ETL_BATCH_SIZE=10
ETL_BACKFILL_YEARS=10
ETL_CHECK_INTERVAL=3600  # seconds (1 hour)

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000/api/v1

# Environment
ENVIRONMENT=development  # development, production
DEBUG=true
